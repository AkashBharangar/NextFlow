{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "paths": {
      "@/*": ["./*"]
    },
    "baseUrl": "."
  },
  "include": [
    "worker.ts",
    "lib/**/*",
    "workers/**/*",
    "queues/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "app",
    "components",
    "pages"
  ]
}
